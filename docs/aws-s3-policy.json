{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "StoreRepresentativeImages",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/place-images/*"
    },
    {
      "Sid": "StoreDatabaseBackups",
      "Effect": "Allow",
      "Action": ["s3:PutObject"],
      "Resource": "arn:aws:s3:::REPLACE_BUCKET/database-backups/*"
    }
  ]
}
