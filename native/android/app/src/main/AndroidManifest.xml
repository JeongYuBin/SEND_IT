<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <application android:label="SendIT" android:theme="@style/SendITTheme" android:allowBackup="false" android:usesCleartextTraffic="false">
    <activity android:name=".MainActivity" android:exported="true">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
    </activity>
    <activity android:name=".ShareActivity" android:exported="true" android:theme="@style/SendITShareTheme" android:excludeFromRecents="true" android:taskAffinity="" android:windowSoftInputMode="adjustResize">
      <intent-filter><action android:name="android.intent.action.SEND" /><category android:name="android.intent.category.DEFAULT" /><data android:mimeType="text/plain" /></intent-filter>
    </activity>
  </application>
</manifest>
